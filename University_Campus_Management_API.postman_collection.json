            ],
            "url": {
              "raw": "{{baseUrl}}/courses?department=Computer Science",
              "host": ["{{baseUrl}}"],
              "path": ["courses"],
              "query": [
                { "key": "department", "value": "Computer Science" }
              ]
            }
          }
        },
        {
          "name": "3.2 Create Course (Admin - Success 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseCode\": \"CS401\",\n  \"title\": \"Distributed Systems and Microservices\",\n  \"description\": \"Advanced architecture, consensus protocols and fault-tolerant computing.\",\n  \"credits\": 4,\n  \"department\": \"Computer Science\",\n  \"semester\": 7\n}"
