    {
      "name": "8. MongoDB Aggregations & Reports",
      "item": [
        {
          "name": "8.1 Attendance Analytics & Low-Attendance Defaulters List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/attendance-analytics?threshold=75&defaultersOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "attendance-analytics"],
              "query": [
                { "key": "threshold", "value": "75" },
                { "key": "defaultersOnly", "value": "true" }
              ]
            }
